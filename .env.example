# Copy to .env for local dev (never commit the real .env — it's in .gitignore)

# Leave unset locally to use SQLite (vivek_feedback.db). On Render, paste the
# managed Postgres "Internal Database URL" here.
DATABASE_URL=

# From your Meta developer app (developers.facebook.com -> your app -> WhatsApp -> API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Any string you make up yourself — put the SAME value in the Meta webhook config
WHATSAPP_VERIFY_TOKEN=vivek-dev-verify-token
